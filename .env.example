# Optional: npm start works without copying this file.
HOST=127.0.0.1
PORT=8788
DATA_DIR=./storage
# Required for a public domain or LAN access; no trailing slash.
# PUBLIC_ORIGIN=https://your-domain.example
# Leave unset to generate and persist a random key in DATA_DIR/signing-key.
# SUBMISSION_SECRET=
# Default 0 ignores all forwarded headers. Only enable behind controlled proxies.
TRUST_PROXY_HOPS=0
